[Unit]
Description=Atum3D dashboard backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/dashboard/backend
EnvironmentFile=/home/admin/dashboard/backend/.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
