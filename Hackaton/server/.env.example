# Kopieer naar server/.env. Dit bestand staat in .gitignore; zet sleutels NOOIT in de frontend.

# auto (standaard) | anthropic | openai | none
#   auto: anthropic als ANTHROPIC_API_KEY is gezet, anders openai als OPENAI_BASE_URL is gezet, anders none.
#   none: ingebouwde Nederlandse gespreksleider, geen extern taalmodel (gratis, offline).
LLM_PROVIDER=auto

# Optie 1: Claude (Anthropic API)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optie 2: gratis/open-source via een OpenAI-compatibele server, bijv. Ollama:
#   ollama pull llama3.1 && ollama serve
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1
# OPENAI_API_KEY=            # alleen nodig voor gehoste diensten (bijv. Groq)

# LLM_TIMEOUT_MS=20000
# PORT=8787
# MINORS_FILE=data/minors.json

# Lokale spraak (npm run setup:speech). auto = gebruiken als geïnstalleerd, off = altijd de browser.
# LOCAL_SPEECH=auto
# STT_MODEL=onnx-community/whisper-small     # sneller: onnx-community/whisper-base
# PIPER_VOICE=nl_NL-pim-medium                # andere: nl_NL-ronnie-medium, nl_BE-nathalie-medium
# PIPER_SPEED=1.12
