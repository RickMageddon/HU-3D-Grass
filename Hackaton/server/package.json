{
  "name": "minoren-in-de-buurt-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "NODE_ENV=production tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "import": "tsx src/importer/cli.ts",
    "test": "vitest run",
    "setup:speech": "tsx scripts/setup-speech.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@huggingface/transformers": "^4.3.1",
    "cheerio": "^1.2.0",
    "domhandler": "^6.0.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
